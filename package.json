{
  "name": "autochatbot-fb-crm",
  "version": "1.0.0",
  "description": "FB Personal Messenger CRM - Desktop Application",
  "author": "Adsup <contact@adsup.vn>",
  "main": "src/electron.js",
  "scripts": {
    "start": "node src/server/index.js",
    "dev:server": "node src/server/index.js",
    "dev:ui": "vite",
    "build:ui": "vite build",
    "build:bytecode": "node scripts/build-bytecode.js",
    "build:extension": "node scripts/obfuscate-extension.js",
    "build:all": "npm run build:ui && npm run build:bytecode && npm run build:extension",
    "dist": "npm run build:all && electron-builder",
    "dist:win": "npm run build:all && electron-builder --win",
    "dist:linux": "npm run build:all && electron-builder --linux",
    "test:db": "node src/server/database/db.js",
    "test:services": "node -e \"require('./src/server/services/AutoReplyEngine'); require('./src/server/services/BroadcastEngine'); require('./src/server/services/AIMediator'); console.log('All Sprint 4 services OK')\"",
    "test:persistence": "node --test tests/integration/*.test.js tests/unit/*.test.js"
  },
  "dependencies": {
    "archiver": "^5.3.2",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.8.0",
    "emoji-picker-react": "^4.19.1",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-colorful": "^5.8.0",
    "react-dom": "^19.0.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^4.3.4",
    "bytenode": "^1.6.0",
    "electron": "^31.0.0",
    "electron-builder": "^26.15.3",
    "javascript-obfuscator": "^5.5.0",
    "tailwindcss": "^4.3.3",
    "vite": "^6.1.0"
  }
}
