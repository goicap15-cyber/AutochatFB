PAGE_TOKEN_SECRET="change-me"
WEBHOOK_VERIFY_TOKEN="change-me"
META_APP_SECRET="change-me"
TUNNEL="https://your-tunnel-domain.example.com"

# Rich-message attachment capabilities (spec 027). Only enable a flag after
# its source/type pair has passed the live acceptance matrix (T054) in
# specs/027-crm-rich-messaging/quickstart.md - each one turns on real
# customer-facing delivery for that source/type combination.
# RICH_MESSAGE_PAGE_IMAGE_ENABLED=true
# RICH_MESSAGE_PAGE_FILE_ENABLED=true
# RICH_MESSAGE_PERSONAL_IMAGE_ENABLED=true
# RICH_MESSAGE_PERSONAL_FILE_ENABLED=true

# Optional overrides (defaults shown):
# RICH_MESSAGE_ENABLED=true
# RICH_MESSAGE_MAX_BYTES=8388608
